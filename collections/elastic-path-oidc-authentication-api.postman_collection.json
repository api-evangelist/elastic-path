{
  "item": [
    {
      "id": "582e8566-f224-4967-93b6-2fa628511ac2",
      "name": "OIDC Authentication",
      "description": {
        "content": "The OIDC IDP Login endpoints handle the initiation of OpenID Connect authentication flows.\n\nWhen a user needs to authenticate via OIDC, they are redirected to these endpoints which then redirect them to the configured OIDC provider for authentication.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "ec5fb075-4250-4698-b6c2-a74893c7117e",
          "name": "Initiate OIDC Login",
          "request": {
            "name": "Initiate OIDC Login",
            "description": {
              "content": "Initiate the OIDC login flow for a specific store and authentication realm\n::: note This is not an **API Endpoint**, but the [Authentication Request](https://openid.net/specs/openid-connect-core-1_0.html#AuthRequest) of the OpenID Connect Authentication Flow.\nTo initiate an OpenID Connect authentication you must change the location in the Browser to this URL, not call it asynchronously. :::",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oidc-idp",
                "login",
                "stores",
                ":storeId",
                "authentication-realms",
                ":realmId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) The Client ID, for Account Management Authentication see the `meta.client_id` field on [Account Authentication Settings](/docs/api/accounts/get-v-2-settings-account-authentication)."
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<uri>",
                  "description": "(Required) Redirection URI to which the response will be sent. Must exactly match a pre-registered redirect URI for the client in the `redirect_uris` of the [Authentication Realm](/docs/api/single-sign-on/get-v-2-authentication-realms-realm-id)."
                },
                {
                  "disabled": false,
                  "key": "response_type",
                  "value": "<string>",
                  "description": "(Required) OIDC/OAuth 2.0 response type, this must be \"code\" in Commerce."
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "(Required) Space-delimited list of scopes. Must include \"openid\", \"email\", and \"name\"."
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "(Required) Opaque value used to maintain state between the request and the callback. Helps prevent CSRF."
                },
                {
                  "disabled": false,
                  "key": "code_challenge_method",
                  "value": "<string>",
                  "description": "(Required) [Proof Key for Code Exchange (PKCE)](https://datatracker.ietf.org/doc/html/rfc7636) transformation method that was used to derive code_challenge."
                },
                {
                  "disabled": false,
                  "key": "code_challenge",
                  "value": "<string>",
                  "description": "(Required) [Proof Key for Code Exchange (PKCE)](https://datatracker.ietf.org/doc/html/rfc7636) Code Challenge."
                },
                {
                  "disabled": false,
                  "key": "prompt",
                  "value": "<string>",
                  "description": "Space-delimited, case-sensitive list that specifies whether the Authorization Server prompts the End-User for re-authentication and consent.  This value is passed to the configured IdP. See [Section 3.1.2.1. Authentication Request - OpenID Connect Core 1.0](https://openid.net/specs/openid-connect-core-1_0.html#AuthRequest)."
                },
                {
                  "disabled": false,
                  "key": "display",
                  "value": "<string>",
                  "description": "ASCII string value that specifies how the Authorization Server displays the authentication and consent user interface. This value is passed to the configured IdP. See [Section 3.1.2.1. Authentication Request - OpenID Connect Core 1.0](https://openid.net/specs/openid-connect-core-1_0.html#AuthRequest)."
                },
                {
                  "disabled": false,
                  "key": "ui_locales",
                  "value": "<string>",
                  "description": "End-User's preferred languages and scripts for the user interface, represented as space-separated list of BCP47 language tag values. This value is forwarded to the configured IdP.  See [Section 3.1.2.1. Authentication Request - OpenID Connect Core 1.0](https://openid.net/specs/openid-connect-core-1_0.html#AuthRequest)."
                },
                {
                  "disabled": false,
                  "key": "elasticpath_commerce_cloud_profile_id",
                  "value": "<uuid>",
                  "description": "(Required) Selects the specific OIDC Profile within the realm to use for authentication."
                },
                {
                  "disabled": false,
                  "key": "ep_report_callback_replay_error",
                  "value": "<boolean>",
                  "description": "Custom boolean flag. If true, if the user attempts to hit back in their browser, we will redirect them back to the store front"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "storeId",
                  "description": "(Required) The ID of the store."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "realmId",
                  "description": "(Required) The ID of the authentication realm."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
